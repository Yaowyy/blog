---
import '../styles/global.css';
const { page = 'home', feed = false } = Astro.props;   // feed: the blog list, one post per screen with scroll snapping
// SEO: description, link preview (Open Graph) and structured data. A blog post passes its own title, description and date.
const { description, ogTitle, image = '/art/ui/og-game.jpg', type = 'website', published } = Astro.props;
const DESCRIPTIONS = {
  home: 'Andrii Kashevskyi, a Digital Marketing student in London. I build Neon Hustle, a cyberpunk browser game, run a Rust server community and write about marketing, games and AI.',
  blog: 'Blog posts by Andrii Kashevskyi: building Neon Hustle, marketing experiments and the AI tools I use.',
  portfolio: 'Portfolio of Andrii Kashevskyi: Digital Marketing at Anglia Ruskin University, certificates and work experience in sales, hospitality and e-commerce.',
  contact: 'How to get in touch with Andrii Kashevskyi.',
  privacy: 'Privacy notice for andrii.blog and the Neon Hustle browser game.',
};
const OG_TITLES = {
  home: 'Andrii Kashevskyi: Digital Marketing student and game builder',
  blog: 'Blog · Andrii Kashevskyi',
  portfolio: 'Portfolio · Andrii Kashevskyi',
  contact: 'Contact · Andrii Kashevskyi',
  privacy: 'Privacy notice · andrii.blog',
};
const metaDesc = description || DESCRIPTIONS[page] || DESCRIPTIONS.home;
const metaTitle = ogTitle || OG_TITLES[page] || 'Andrii Kashevskyi';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const LINKEDIN = 'https://www.linkedin.com/in/andrii-kashevskyi/';
const person = { '@type': 'Person', name: 'Andrii Kashevskyi', url: 'https://andrii.blog/', sameAs: [LINKEDIN],
  jobTitle: 'Digital Marketing student', affiliation: { '@type': 'CollegeOrUniversity', name: 'Anglia Ruskin University' } };
const jsonLd = page === 'home'
  ? { '@context': 'https://schema.org', '@graph': [{ ...person, '@id': 'https://andrii.blog/#me' },
      { '@type': 'WebSite', name: 'andrii.blog', url: 'https://andrii.blog/', author: { '@id': 'https://andrii.blog/#me' } }] }
  : type === 'article'
  ? { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: metaTitle, description: metaDesc, url: canonical, image: imageUrl,
      datePublished: published ? new Date(published).toISOString().slice(0, 10) : undefined, author: person }
  : null;

const logos = {
  home: 'andrii.kashevskyi',
  blog: 'andrii.blog',
  portfolio: 'andrii.portfolio',
  contact: 'andrii.contact',
  hk: 'andrii.香港',
  privacy: 'andrii.privacy',
};

// the archived Hong Kong planner is not linked from anywhere (it still works at /hk-planner)
const navLinks = [
  { href: '/blog', label: 'blog', page: 'blog' },
  { href: '/portfolio', label: 'portfolio', page: 'portfolio' },
  { href: '/contact', label: 'contact', page: 'contact' },
];
---

<!doctype html>
<html lang="en-GB" class:list={[feed && 'feed']}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    {page === 'hk' && <meta name="robots" content="noindex, nofollow" />}
    <title>{logos[page]}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="andrii.blog" />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // set the theme before the page paints, so there is no white flash in dark mode
      (() => {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
      })();
    </script>
    <style>
      @keyframes fadein {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: none; }
      }
      main { animation: fadein 0.6s ease forwards; }

      .toggle-switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 22px;
        cursor: pointer;
      }
      .toggle-switch input { opacity: 0; width: 0; height: 0; position: absolute; }
      .slider {
        position: absolute;
        inset: 0;
        background: var(--bg);
        border: 1px solid var(--fg);
        border-radius: 999px;
        transition: background 0.3s ease;
      }
      .slider::before {
        content: '';
        position: absolute;
        width: 14px;
        height: 14px;
        left: 3px;
        top: 3px;
        background: var(--fg);
        border-radius: 50%;
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.3s ease;
      }
      .toggle-switch input:checked + .slider { background: var(--fg); }
      .toggle-switch input:checked + .slider::before { transform: translateX(18px); background: var(--bg); }
    </style>
  </head>
  <body class="bg-bg text-fg font-sans min-h-screen flex flex-col">

    <!-- Navigation -->
    <nav class="border-b border-line px-4 py-5">
      <div class="max-w-2xl mx-auto flex flex-wrap justify-between items-center gap-x-6 gap-y-2">
        <a href="/" class="text-xl font-semibold tracking-tight group">
          <span class="group-hover:hidden">{logos[page]}</span>
          <span class="hidden group-hover:inline">andrii.kashevskyi</span>
        </a>
        <div class="flex gap-4 sm:gap-6 text-sm">
          {navLinks.map(link => (
            <a href={link.href} class:list={['transition-colors border-b pb-0.5', link.page === page ? 'text-fg border-fg' : 'text-muted border-transparent hover:text-fg']}>{link.label}</a>
          ))}
        </div>
      </div>
    </nav>

    <!-- Page content -->
    <main class={page === 'hk' ? 'w-full p-0 flex-1' : feed ? 'flex-1 w-full max-w-2xl mx-auto px-4' : 'flex-1 w-full max-w-2xl mx-auto px-4 py-14 prose prose-neutral dark:prose-invert'}>
      <slot />
    </main>

    <!-- Footer -->
    <footer class:list={['border-t border-line px-4 py-6', !feed && 'mt-16']}>
      <div class="max-w-2xl mx-auto flex items-center justify-between text-xs text-muted">
        <span>© 2026 Andrii Kashevskyi · <a href="/privacy" class="hover:text-fg transition-colors">privacy</a></span>
        <label class="toggle-switch" aria-label="Toggle dark mode">
          <input type="checkbox" id="dark-toggle" />
          <span class="slider"></span>
        </label>
      </div>
    </footer>

    <script>
      // feed pages snap one post per screen: the posts sit under the sticky menu, so the screen minus its height is one page
      const nav = document.querySelector('nav');
      const setNavH = () => document.documentElement.style.setProperty('--nav-h', (nav?.offsetHeight || 70) + 'px');
      setNavH(); addEventListener('resize', setNavH);

      const toggle = document.getElementById('dark-toggle') as HTMLInputElement;
      toggle.checked = document.documentElement.classList.contains('dark');
      toggle.addEventListener('change', () => {
        const isDark = toggle.checked;
        document.documentElement.classList.toggle('dark', isDark);
        document.querySelector('.hk-wrap')?.classList.toggle('dark', isDark);
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
