---
import Layout from '../layouts/Layout.astro';
---

<Layout page="portfolio">
  <div class="not-prose space-y-16">

    <!-- Education -->
    <div>
      <p class="label">Education</p>
      <div class="flex justify-between items-baseline">
        <div>
          <p class="text-sm font-medium">Anglia Ruskin University London</p>
          <p class="text-sm text-muted">Digital Marketing · Year 2</p>
        </div>
        <span class="text-xs text-faint">2025 — present</span>
      </div>
      
    </div>

    <!-- Certificates -->
    <div>
      <p class="label">Certificates</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

        <!-- edX / W3Cx: the certificate picture; opens edX's verification page -->
        <a href="https://courses.edx.org/certificates/b5dfdcfdc4ec4775abf6143f82415c83" target="_blank" class="group block">
          <div class="plate bg-white">
            <div class="absolute inset-0 flex items-center justify-center p-6">
            <img src="/certificates/edx-javascript-certificate.webp" alt="W3Cx JS.0x: JavaScript Introduction, edX verified certificate" loading="lazy"
                 class="w-full h-auto border border-neutral-200" />
            </div>
            <span class="plate-arrow text-black">↗</span>
          </div>
          <p class="text-sm font-medium mt-3">JS.0x: JavaScript Introduction</p>
          <p class="text-xs text-muted mt-0.5">W3Cx · edX · Jun 2022</p>
        </a>

        <!-- IBM SkillsBuild: the Credly badge (its own embed) -->
        <div class="group">
          <div class="plate bg-white">
            <div class="absolute inset-0 flex items-center justify-center">
              <div data-iframe-width="150" data-iframe-height="270" data-share-badge-id="89b7f293-7c26-4876-b8cd-b19fa3cc1219" data-share-badge-host="https://www.credly.com"></div>
            </div>
          </div>
          <a href="https://www.credly.com/badges/89b7f293-7c26-4876-b8cd-b19fa3cc1219/public_url" target="_blank" class="block hover:text-muted transition-colors">
            <p class="text-sm font-medium mt-3">AI Fundamentals with Capstone Project</p>
            <p class="text-xs text-muted mt-0.5">IBM SkillsBuild · Dec 2025</p>
          </a>
        </div>

      </div>
      <script is:inline async src="https://cdn.credly.com/assets/utilities/embed.js"></script>
    </div>

    <!-- Work Experience -->
    <div>
      <p class="label">Work Experience</p>
      <div class="divide-y divide-line">
        <div class="grid grid-cols-3 py-4 text-sm">
          <span class="font-medium">Agency Supervisor</span>
          <span class="text-muted">RAM Agency. Hospitality</span>
          <span class="text-faint text-right">2024-2026</span>
        </div>
        <div class="grid grid-cols-3 py-4 text-sm">
          <span class="font-medium">Service Staff</span>
          <span class="text-muted">Youngs&Co. Hospitality</span>
          <span class="text-faint text-right">2022-2024</span>
        </div>
        <div class="grid grid-cols-3 py-4 text-sm">
          <span class="font-medium">Solar Installer</span>
          <span class="text-muted">Renewable Energy</span>
          <span class="text-faint text-right">2023</span>
        </div>
        <div class="grid grid-cols-3 py-4 text-sm">
          <span class="font-medium">Salesman</span>
          <span class="text-muted">Orchid. Sales</span>
          <span class="text-faint text-right">2022</span>
        </div>
        <div class="grid grid-cols-3 py-4 text-sm">
          <span class="font-medium">Salesman</span>
          <span class="text-muted">British American Tobacco. Sales</span>
          <span class="text-faint text-right">2020</span>
        </div>
        <div class="grid grid-cols-3 py-4 text-sm">
          <span class="font-medium">Administrator</span>
          <span class="text-muted">PlayHub. IT</span>
          <span class="text-faint text-right">2019</span>
        </div>
      </div>
    </div>

  </div>
</Layout>
